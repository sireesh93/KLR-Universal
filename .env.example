# Copy to .env.local for local development, and set the same values in
# Vercel → Project → Settings → Environment Variables for production.

# Required. Create at https://resend.com/api-keys
# Without this the enquiry form returns a friendly error and sends nothing.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered. Defaults to sales@klruniversal.com.
CONTACT_TO_EMAIL=sales@klruniversal.com

# Sender address. MUST be on a domain verified in the Resend account
# (Resend → Domains). The default, onboarding@resend.dev, works only for
# testing and delivers solely to the Resend account owner's address.
CONTACT_FROM_EMAIL="KLR Universal <enquiries@klruniversal.com>"
