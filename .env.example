# Copy to .env.local for local development. On Hostinger set the same values in
# hPanel -> Web Apps -> your app -> Environment variables, then redeploy.

# --- Email transport (Zoho Mail SMTP) ------------------------------------
# Required in production. Generate an app-specific password in Zoho:
#   Zoho Mail -> My Account -> Security -> App Passwords.
# Never use the account login password here.
ZOHO_SMTP_USER=info@bycconsulting.in
ZOHO_SMTP_PASS=xxxxxxxxxxxxxxxx

# Region-specific host. The sending account is India-hosted, so smtp.zoho.in.
# Use smtp.zoho.com (US) or smtp.zoho.eu (EU) if the account lives there --
# logging in against the wrong region fails authentication.
ZOHO_SMTP_HOST=smtp.zoho.in

# 465 = implicit TLS (default). Use 587 if the host blocks 465.
ZOHO_SMTP_PORT=465

# --- Addressing -----------------------------------------------------------
# Where enquiries are delivered. Comma-separated; every address gets a copy.
CONTACT_TO_EMAIL=sales@klruniversal.com,info@bycconsulting.in

# Sender. Zoho only accepts the authenticated mailbox or one of its verified
# aliases, so this must match ZOHO_SMTP_USER or be an alias that mailbox owns.
CONTACT_FROM_EMAIL="KLR Universal <info@bycconsulting.in>"
